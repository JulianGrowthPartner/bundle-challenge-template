"]');\n      addToCartButton.insertAdjacentHTML(\"afterend\", bundleHTML);\n    }\n  });\n\n  window.addBundleToCart = async (mainHandle, bundleHandle) => {\n    const response = await fetch(`/products/${mainHandle}.js`);\n    const mainData = await response.json();\n\n    const response2 = await fetch(`/products/${bundleHandle}.js`);\n    const bundleData = await response2.json();\n\n    const mainId = mainData.variants[0].id;\n    const bundleId = bundleData.variants[0].id;\n\n    await fetch('/cart/add.js', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({\n        items: [\n          { id: mainId, quantity: 1, properties: { _bundle: 'true' } },\n          { id: bundleId, quantity: 1, properties: { _bundle: 'true' } }\n        ]\n      })\n    });\n\n    window.location.href = \"/cart\";\n  };\n</script>"
